# AFS Bancada Inteligente — deploy completo na Netlify
# Cadastre estas variáveis em: Netlify → Site settings → Environment variables
# NUNCA suba este arquivo preenchido para um repositório público.

# Banco de dados Turso (crie grátis em https://turso.tech)
# Database URL e token ficam na página do banco no painel do Turso.
TURSO_DATABASE_URL=libsql://SEU-BANCO.turso.io
TURSO_AUTH_TOKEN=

# IA da Meta — API de modelos (https://dev.meta.ai)
# Crie a API key no painel e copie a URL base e o nome do modelo
# indicados na página de início rápido (quickstart) da API.
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
